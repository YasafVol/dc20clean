VITE_USERBACK_ACCESS_TOKEN=

# PostHog Cloud EU. The project token is public browser configuration, not a secret.
VITE_ENABLE_ANALYTICS=false
# Separately gates the consent UI and the draft Privacy/Terms pages and links.
# When false, configured PostHog analytics runs without an in-app consent choice.
VITE_ENABLE_LEGAL_CONSENT_FLOW=false
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
